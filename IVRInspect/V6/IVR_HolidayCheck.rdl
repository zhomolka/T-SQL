  <DataSets>
    <DataSet Name="KrokyIVR">
      <Query>
        <DataSourceName>Frontstage</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@IvrScript">
            <Value>=Parameters!IvrScript.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@MyDateTime">
            <Value>=Parameters!MyDateTime.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SET DATEFIRST 1;
SELECT
*
FROM .[dbo].[FSC_rep_IVR_HolidayCheck] (@IvrScript,@MyDateTime) 
Order by Rank</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
