    <DataSet Name="Ivr">
      <Query>
        <DataSourceName>Frontstage</DataSourceName>
        <CommandText>select concat(DisplayName, case when Description &lt;&gt; '' then ' (' + Description + ')' else null end) as IvrName from .dbo.IvrScript with (nolock) where Deleted = 0 order by DisplayName</CommandText>
      </Query>
      <Fields>
        <Field Name="IvrName">
          <DataField>IvrName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
