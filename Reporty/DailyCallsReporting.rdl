  <Code>
    Function TimeSpan(dt1)

    Dim seconds = dt1
    Dim minutes = seconds \ 60
    Dim hours = minutes \ 60
    minutes = minutes mod 60
    seconds = seconds mod 60

    if len(hours) = 1 then hours = "0" &amp; hours

    TimeSpan = hours &amp; ":" &amp; _
    RIGHT("00" &amp; minutes, 2) &amp; ":" &amp; _
    RIGHT("00" &amp; Round(seconds), 2)
    End Function

  Public Function Percents(Numerator As Single, Denominator As Single) As Single
   If Denominator =0 Then  
      Return 1
    Else 
       IF Numerator/ Denominator &gt;1 Then
           Return 1
       ELSE
           Return Numerator/ Denominator
       END IF
     End If  
End Function  

Public Function Denominator (Val1 As Single) As Single
   If Val1=0 Then  
      Return 1
      Else : Return Val1
   End If  
End Function  


Public Function SLA(Numerator As Single, Denominator As Single) As Single
  DIM SlaValue AS Single
   SlaValue = Percents( Numerator, Denominator )
   SlaValue = SlaValue/0.9
         IF SlaValue &gt;1 Then
           Return 1
       ELSE
           Return SlaValue
       END IF
 End Function  

</Code>
