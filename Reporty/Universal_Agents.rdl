                              <TextRuns>
                                <TextRun>
                                  <Value>=
iif((Sum(Fields!ReadyDuration.Value) - Sum(Fields!CallDuration.Value) - Sum(Fields!RingDuration.Value))/sum(Fields!LoggedDuration.Value)&gt;0,
iif(sum(Fields!LoggedDuration.Value)&gt;1,(Sum(Fields!ReadyDuration.Value) - Sum(Fields!CallDuration.Value) - Sum(Fields!RingDuration.Value))/sum(Fields!LoggedDuration.Value),0),0)</Value>
                                  <Style>
                                    <FontSize>8pt</FontSize>
                                    <Format>0.0%</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
