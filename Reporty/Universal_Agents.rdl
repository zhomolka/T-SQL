                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=IIF(SUM(Fields!LoggedDuration.Value)&gt;0,sum(Fields!NRStatus_Prodleva.Value)/SUM(Fields!LoggedDuration.Value),0)</Value>
