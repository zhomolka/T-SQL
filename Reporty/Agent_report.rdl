    <DataSet Name="StatusesRD">
      <Query>
        <DataSourceName>iCC</DataSourceName>
        <CommandText> SELECT [DisplayName]
   FROM .[dbo].[Status] WHERE Activity='Ready' 
UNION
  SELECT 'ž Rezerva'
 ORDER BY DisplayName</CommandText>
      </Query>
      <Fields>
        <Field Name="DisplayName">
          <DataField>DisplayName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="StatusesLO">
      <Query>
        <DataSourceName>iCC</DataSourceName>
        <CommandText> SELECT [DisplayName]
   FROM .[dbo].[Status] WHERE Activity='Logoff'
  UNION
  SELECT 'ž Rezerva'
 ORDER BY DisplayName</CommandText>
      </Query>
      <Fields>
        <Field Name="DisplayName">
          <DataField>DisplayName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
