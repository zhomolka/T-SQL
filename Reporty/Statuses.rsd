<?xml version="1.0" encoding="utf-8"?>
<SharedDataSet xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/shareddatasetdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSet Name="">
    <Query>
      <DataSourceReference>ICC</DataSourceReference>
      <CommandText> SELECT StatusId,[DisplayName]
   FROM .[dbo].[Status] WHERE (Activity='Pause' OR Activity='PostCall') AND Deleted=0 ORDER BY DisplayName</CommandText>
    </Query>
    <Fields>
      <Field Name="StatusId">
        <DataField>StatusId</DataField>
        <rd:TypeName>System.Guid</rd:TypeName>
      </Field>
      <Field Name="DisplayName">
        <DataField>DisplayName</DataField>
        <rd:TypeName>System.String</rd:TypeName>
      </Field>
    </Fields>
  </DataSet>
</SharedDataSet>