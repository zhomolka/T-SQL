  <Code>    Function Dur(ByVal d As Integer) As String
         If d = 0 Then Return ""
        Dim t = System.TimeSpan.FromSeconds(d)
        Return t.ToString()
    End Function

Function TimeSpan(dt1) 

	Dim seconds = dt1 
	Dim minutes = seconds \ 60 
	Dim hours = minutes \ 60 
	minutes = minutes mod 60 
	seconds = seconds mod 60 

	if len(hours) = 1 then hours = "0" &amp; hours 

	TimeSpan = hours &amp; ":" &amp; _ 
	RIGHT("00" &amp; minutes, 2) &amp; ":" &amp; _ 
	RIGHT("00" &amp; Round(seconds), 2) 
End Function

</Code>
