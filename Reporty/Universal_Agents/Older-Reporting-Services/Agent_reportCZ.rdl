    <DataSet Name="Statuses">
      <Query>
        <DataSourceName>iCC</DataSourceName>
        <CommandText> SELECT [DisplayName]
   FROM .[dbo].[Status] WHERE Activity='Pause' OR Activity='PostCall' ORDER BY DisplayName</CommandText>
      </Query>
      <Fields>
        <Field Name="DisplayName">
          <DataField>DisplayName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="GroupName">
      <Query>
        <DataSourceName>iCC</DataSourceName>
        <CommandText>SELECT DISTINCT
      [GroupName]
  FROM [iCC].[dbo].[Agent] WHERE Deleted=0</CommandText>
      </Query>
      <Fields>
        <Field Name="GroupName">
          <DataField>GroupName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Agents">
      <Query>
        <DataSourceName>iCC</DataSourceName>
        <CommandText>SELECT [AgentId]
      ,[DisplayName]
      ,GroupName
  FROM .[dbo].[Agent] WHERE Deleted=0  AND TeamName NOT LIKE '%ADMIN%' ORDER BY DisplayName</CommandText>
      </Query>
      <Fields>
        <Field Name="AgentId">
          <DataField>AgentId</DataField>
          <rd:TypeName>System.Guid</rd:TypeName>
        </Field>
        <Field Name="DisplayName">
          <DataField>DisplayName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="GroupName">
          <DataField>GroupName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
